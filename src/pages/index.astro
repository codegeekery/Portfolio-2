---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import Report from '../components/Report.astro';
import Quote from '../components/Quote.astro';
import Prices from '../components/Prices.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Horizonte, análisis de suelo para tu parcela"
  description="Pide un kit, toma la muestra y en 10 días recibe un análisis de laboratorio con un plan de fertilización para tu cultivo."
>
  <Header />
  <main>
    <Hero />
    <Steps />
    <Report />
    <Quote />
    <Prices />
    <Faq />
  </main>
  <Footer />
</Base>
